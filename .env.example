# cp .env.example .env  — then change the password (keep it identical in both places)
POSTGRES_DB=newscal
POSTGRES_USER=newscal
POSTGRES_PASSWORD=change_me_please
ConnectionStrings__Default=Host=db;Port=5432;Database=newscal;Username=newscal;Password=change_me_please

# Blank = open writes (OK only on a trusted home LAN). For ANY public exposure set a long random value:
#   openssl rand -hex 32
# Writes (POST/PUT/DELETE) then require the header  X-Api-Key: <value>.  Reads stay open.
API_KEY=

# Only needed when a browser calls the API from a different origin. Via the web container's /api proxy it isn't.
# Public use: your https URL, e.g. https://news.example.com
CORS_ORIGINS=http://localhost:8088

TZ=America/New_York

# Home Assistant embedding: ONE exact origin allowed to iframe this app (scheme + host + port, no path).
# Example: http://192.168.1.50:8123   Leave blank to disallow embedding.
HA_ORIGIN=

# Which host address publishes port 8088. 0.0.0.0 = every network interface (LAN).
# 127.0.0.1 = only this machine, i.e. only your reverse proxy / tunnel. Use 127.0.0.1 for public setups.
WEB_BIND=0.0.0.0
